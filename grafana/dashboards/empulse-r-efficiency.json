    {
      "id": 3,
      "type": "stat",
      "title": "Deep-Depletion Drives (>=30% SoC used)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
