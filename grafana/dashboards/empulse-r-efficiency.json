    {
      "id": 4,
      "type": "table",
      "title": "Range by Depletion Depth (shows the extrapolation bias)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "SELECT\n  CASE\n    WHEN soc_used_pct < 15 THEN '5-15%'\n    WHEN soc_used_pct < 30 THEN '15-30%'\n    WHEN soc_used_pct < 50 THEN '30-50%'\n    ELSE '50%+'\n  END AS soc_used,\n  count(*) AS n_drives,\n  round(avg(avg_speed_mph * 1.609344),1) AS avg_speed_kmh,\n  round(sum(distance_mi * 1.609344)) AS total_km,\n  round(sum(distance_mi) / sum(soc_used_pct) * 100 * 1.609344) AS range_at_100pct_km\nFROM drive_range_estimates\nWHERE $__timeFilter(started_at)\nGROUP BY 1\nORDER BY min(soc_used_pct)",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_speed_kmh"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "total_km"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthkm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "range_at_100pct_km"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthkm"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Range by Average Riding Speed (drag scales ~v^2)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "WITH base AS (\n  SELECT soc_used_pct, distance_mi, started_at,\n    avg_speed_mph * 1.609344 AS avg_speed_kmh, range_at_100pct_mi * 1.609344 AS range_at_100pct_km\n  FROM drive_range_estimates\n)\nSELECT\n  CASE WHEN avg_speed_kmh < 30 THEN '<30 km/h' WHEN avg_speed_kmh < 45 THEN '30-45 km/h' WHEN avg_speed_kmh < 60 THEN '45-60 km/h' ELSE '60+ km/h' END AS avg_speed,\n  count(*) AS n_drives,\n  round(avg(range_at_100pct_km)) AS avg_range_at_100pct_km,\n  round(sum(distance_mi) / sum(soc_used_pct) * 100 * 1.609344) AS weighted_range_at_100pct_km\nFROM base\nWHERE $__timeFilter(started_at)\nGROUP BY 1\nORDER BY min(avg_speed_kmh)",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_range_at_100pct_km"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthkm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "weighted_range_at_100pct_km"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthkm"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Range by Ambient Temperature (avg speed shown to rule out a speed confound)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "WITH base AS (\n  SELECT soc_used_pct, distance_mi, avg_air_temp_f, started_at,\n    (avg_air_temp_f - 32) * 5.0/9.0 AS avg_temp_c, avg_speed_mph * 1.609344 AS avg_speed_kmh\n  FROM drive_range_estimates\n)\nSELECT\n  CASE WHEN avg_temp_c < 5 THEN '<5C' WHEN avg_temp_c < 15 THEN '5-15C' WHEN avg_temp_c < 25 THEN '15-25C' ELSE '25C+' END AS air_temp,\n  count(*) AS n_drives,\n  round(avg(avg_temp_c),1) AS avg_temp_c,\n  round(avg(avg_speed_kmh),1) AS avg_speed_kmh,\n  round(sum(distance_mi) / sum(soc_used_pct) * 100 * 1.609344) AS weighted_range_at_100pct_km\nFROM base\nWHERE avg_air_temp_f IS NOT NULL AND $__timeFilter(started_at)\nGROUP BY 1\nORDER BY min(avg_temp_c)",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avg_temp_c"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "avg_speed_kmh"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "weighted_range_at_100pct_km"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthkm"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
