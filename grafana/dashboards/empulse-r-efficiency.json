      "id": 1,
      "type": "stat",
      "title": "Avg. Range at 100% SoC (deep-depletion drives, >=30% SoC used)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "SELECT round(sum(distance_mi) / sum(soc_used_pct) * 100 * 1.609344) FROM drive_range_estimates WHERE soc_used_pct >= 30 AND $__timeFilter(started_at)",
          "format": "table",
          "refId": "A",
