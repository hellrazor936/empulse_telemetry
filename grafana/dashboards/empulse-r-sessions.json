    {
      "id": 7,
      "type": "table",
      "title": "Drive Sessions (click a row to open)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "SELECT\n  source_file, started_at, ended_at,\n  round(extract(epoch from duration)/60,1) AS duration_min,\n  round((odometer_end_mi - odometer_start_mi) * 1.609344, 1) AS distance_km,\n  round(max_speed_mph * 1.609344, 1) AS max_speed_kmh,\n  min_soc_pct, max_soc_pct,\n  extract(epoch from started_at)*1000 AS started_epoch,\n  extract(epoch from ended_at)*1000 AS ended_epoch\nFROM sessions WHERE session_type = 'drive'\n  AND $__timeFilter(started_at)\n  AND extract(epoch from duration)/60 >= ${min_duration_min}\n  AND COALESCE((odometer_end_mi - odometer_start_mi) * 1.609344, 0) >= ${min_distance_km}\nORDER BY started_at DESC",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started_at"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Date"
              },
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ride",
                    "targetBlank": false,
                    "url": "/d/empulse-r-session-details/empulse-r-session-details?orgId=1&var-session=${__data.fields.source_file}&from=${__data.fields.started_epoch.numeric}&to=${__data.fields.ended_epoch.numeric}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "started_epoch"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
