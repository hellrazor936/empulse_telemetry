    {
      "id": 10,
      "type": "stat",
      "title": "Capacity Fade / Year",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 18,
        "y": 22,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "WITH baseline AS (\n  SELECT avg(estimated_capacity_wh) AS b FROM (\n    SELECT estimated_capacity_wh FROM charge_capacity_estimates ORDER BY started_at ASC LIMIT 5\n  ) x\n)\nSELECT regr_slope(estimated_capacity_wh, extract(epoch from started_at)/31557600.0) / baseline.b * 100 AS pct_per_year\nFROM charge_capacity_estimates, baseline GROUP BY baseline.b",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Capacity Fade (Total, earliest vs. most recent)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 18,
        "y": 25,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "WITH earliest AS (\n  SELECT avg(estimated_capacity_wh) AS v FROM (\n    SELECT estimated_capacity_wh FROM charge_capacity_estimates ORDER BY started_at ASC LIMIT 5\n  ) x\n), recent AS (\n  SELECT avg(estimated_capacity_wh) AS v FROM (\n    SELECT estimated_capacity_wh FROM charge_capacity_estimates ORDER BY started_at DESC LIMIT 5\n  ) x\n)\nSELECT (recent.v - earliest.v) / earliest.v * 100 AS total_fade_pct\nFROM earliest, recent",
          "format": "table",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "n/a",
