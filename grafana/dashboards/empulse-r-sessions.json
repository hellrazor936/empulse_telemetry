    {
      "id": 9,
      "type": "timeseries",
      "title": "Estimated Pack Capacity Over Time (scaled to 10 kWh nominal at pack start)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bfx97xdyvr6dce"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 18,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bfx97xdyvr6dce"
          },
          "rawSql": "WITH baseline AS (\n  SELECT avg(estimated_capacity_wh) AS b FROM (\n    SELECT estimated_capacity_wh FROM charge_capacity_estimates ORDER BY started_at ASC LIMIT 5\n  ) x\n),\nscaled AS (\n  SELECT started_at, estimated_capacity_wh * (10000.0 / baseline.b) AS estimated_capacity_wh\n  FROM charge_capacity_estimates, baseline\n)\nSELECT started_at AS \"time\", estimated_capacity_wh,\n  avg(estimated_capacity_wh) OVER () AS average_capacity_wh,\n  estimated_capacity_wh / 10000.0 * 100 AS pct_of_baseline\nFROM scaled\nWHERE $__timeFilter(started_at)\nORDER BY started_at",
          "format": "time_series",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "estimated_capacity_wh"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watth"
              },
              {
                "id": "displayName",
                "value": "Capacity"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "average_capacity_wh"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watth"
              },
              {
                "id": "displayName",
                "value": "Average"
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pct_of_baseline"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
